# Пример для nginx НА СЕРВЕРЕ (не в Docker).
# Laravel + Filament: сначала отдаём файлы из public/, остальное — в PHP.
#
# 1) Скопировать public/ из контейнера app (после каждого деплоя с Filament):
#    docker ps --filter name=hrono_app -q | head -1 | xargs -I{} \
#      docker cp {}:/var/www/html/public /var/www/hrono/public
#
# 2) Подключить: ln -s .../host-nginx.conf /etc/nginx/sites-enabled/hrono
# 3) nginx -t && systemctl reload nginx

server {
    listen 8081;
    server_name _;

    root /var/www/hrono/public;
    index index.php;

    charset utf-8;
    client_max_body_size 20M;

    # Статика Filament и прочие assets
    location ~* \.(css|js|mjs|map|woff2?|ttf|eot|svg|ico|png|jpg|jpeg|gif|webp)$ {
        try_files $uri =404;
        expires 7d;
        access_log off;
    }

    location / {
        try_files $uri $uri/ @laravel;
    }

    # PHP в Docker Swarm (app:9000 проброшен на localhost:9000)
    location @laravel {
        include fastcgi_params;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/html/public;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param QUERY_STRING $query_string;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param REQUEST_METHOD $request_method;
        fastcgi_read_timeout 300;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}

# --- Альтернатива: только reverse proxy на Docker nginx ---
# Тогда в Swarm nginx ДОЛЖЕН иметь try_files (swarm.conf), и образ weqil/hrono-nginx.
