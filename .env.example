APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Опционально: жёсткий whitelist origin (через запятую). Если пусто — разрешены все Origin (см. config/cors.php).
# CORS_ALLOWED_ORIGINS=http://localhost:4200,https://localhost,capacitor://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Laravel на хосте: 127.0.0.1 | в Docker (app) переопределяется на postgres в compose
DB_HOST=127.0.0.1
DB_PORT=5432

# Порт HTTP при docker compose (nginx)
APP_PORT=8080
DB_DATABASE=hrono
DB_USERNAME=hrono
DB_PASSWORD=secret

# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Секрет для API с фронта (заголовок X-Api-Secret или Authorization: Bearer …)
# Если не задан — подставляется WS_SECRET_KEY
API_SECRET=

WS_SECRET_KEY=secret

# Moto API: stream — {MOTO_API_URL}races/{id}/stream/open|close
#           results — {MOTO_API_URL}hrono/races/{id}/results
MOTO_API_URL=http://localhost:8080/api/